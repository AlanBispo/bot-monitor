TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
CHECK_INTERVAL_MINUTES=30
DATABASE_PATH=data/prices.db
HTTP_TIMEOUT_SECONDS=15
SOURCE_TIMEOUT_SECONDS=15
ENABLED_STORES=amazon,mercadolivre,magalu
AMAZON_HTTP_TIMEOUT_SECONDS=15
MERCADOLIVRE_HTTP_TIMEOUT_SECONDS=15
MAGALU_HTTP_TIMEOUT_SECONDS=15
AMAZON_SOURCE_TIMEOUT_SECONDS=15
MERCADOLIVRE_SOURCE_TIMEOUT_SECONDS=15
MAGALU_SOURCE_TIMEOUT_SECONDS=15
AMAZON_BROWSER_AUTOMATION_ENABLED=false
MERCADOLIVRE_BROWSER_AUTOMATION_ENABLED=false
MAGALU_BROWSER_AUTOMATION_ENABLED=false
WEB_DISCOVERY_TIMEOUT_SECONDS=10
WEB_DISCOVERY_SOURCE_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=2000000
DISCOVERY_CONCURRENCY=4
MAX_CANDIDATES=50
GENERIC_EXTRACTION_ENABLED=true
# Optional JSON endpoint returning {"results":[{"url":"https://...","title":"..."}]}
# A self-hosted service must be reachable through public DNS/IP; private networks are blocked.
# Snippet prices are never trusted.
GENERIC_DISCOVERY_ENDPOINT=
GENERIC_DISCOVERY_API_KEY=
SEARCH_SESSION_MAX=100
SEARCH_SESSION_MAX_AGE_HOURS=24
