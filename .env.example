TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
CHECK_INTERVAL_MINUTES=30
# Products whose last price is within NEAR_TARGET_PERCENT of the target are checked more often.
CHECK_INTERVAL_NEAR_TARGET_MINUTES=10
NEAR_TARGET_PERCENT=10
# Warn once when every check of a store fails for this many consecutive cycles.
STORE_FAILURE_ALERT_CYCLES=3
# Secondary alerts (lowest price in 90 days, percentage drop, back in stock).
# 0 disables the percentage-drop alert.
PRICE_DROP_ALERT_PERCENT=15
# true: secondary alerts go to one daily summary; false: they are sent immediately.
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME=09:00
# Messages arrive without sound in this period; leave empty to disable.
QUIET_HOURS=22:00-07:00
# Daily copies of the database in data/backups; 0 disables.
BACKUP_KEEP_DAYS=7
DATABASE_PATH=data/prices.db
HTTP_TIMEOUT_SECONDS=15
FETCH_TOTAL_TIMEOUT_SECONDS=30
SOURCE_TIMEOUT_SECONDS=15
ENABLED_STORES=amazon,mercadolivre,magalu
MAX_RESPONSE_BYTES=2000000
DISCOVERY_CONCURRENCY=4
MAX_CANDIDATES=50
GENERIC_EXTRACTION_ENABLED=true
# Optional JSON endpoint returning {"results":[{"url":"https://...","title":"..."}]}
# A self-hosted service must be reachable through public DNS/IP; private networks are blocked.
# Snippet prices are never trusted.
GENERIC_DISCOVERY_ENDPOINT=
# json: custom endpoint; searxng: SearXNG /search with JSON enabled by its operator.
GENERIC_DISCOVERY_FORMAT=json
GENERIC_DISCOVERY_API_KEY=
SEARCH_SESSION_MAX=100
SEARCH_SESSION_MAX_AGE_HOURS=24
